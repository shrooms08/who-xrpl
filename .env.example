# ─────────────────────────────────────────────────────────────
# WHO? — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# The app holds NO custody: no seeds, no private keys, no funds.
# ─────────────────────────────────────────────────────────────

# ── Supabase (Gate 0+) ───────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses RLS — used ONLY by server-side game
# orchestration (Gate 2). Never expose to the client / browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Ledger adapter selection (Gate 3) ────────────────────────
# "mock" (default, instant-success) | "xrpl-testnet"
LEDGER_ADAPTER=mock

# ── XRPL testnet (Gate 3, only when LEDGER_ADAPTER=xrpl-testnet)
# Public testnet JSON-RPC / WebSocket endpoint.
XRPL_NETWORK=wss://s.altnet.rippletest.net:51233
# The app's OWN testnet receiving address for seat-claim payments.
# This is a public address only — the app never stores its secret.
XRPL_APP_ADDRESS=rYourAppTestnetAddress

# ── Payout wallet (Gate 4, SEND side — server-only hot wallet) ──
# A SEPARATE dedicated testnet wallet used ONLY to pay out winners. Fund it via
# the testnet faucet and treat it as a small sponsor pot. NEVER reuse
# XRPL_APP_ADDRESS (that stays receive-only). The seed is read exclusively inside
# lib/ledger/xrpl-testnet.ts, never logged, never sent to the client.
XRPL_PAYOUT_ADDRESS=rYourPayoutTestnetAddress
XRPL_PAYOUT_SEED=sYourPayoutWalletSeed

# ── Xaman / XUMM SDK (Gate 3, server-side only) ──────────────
# From https://apps.xumm.dev
XUMM_API_KEY=your-xumm-api-key
XUMM_API_SECRET=your-xumm-api-secret

# ── Admin ────────────────────────────────────────────────────
# Comma-separated emails allowed to view /admin/ledger in production.
# (In dev, any signed-in user may view it.)
ADMIN_EMAILS=you@example.com

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
